<#compress>
    PREFIX : <${uri?replace(id,"")}>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX dcat: <http://www.w3.org/ns/dcat#>
    PREFIX frapo: <http://purl.org/cerif/frapo/>
    PREFIX scoro: <http://purl.org/spar/scoro/>
    PREFIX foaf: <http://xmlns.com/foaf/0.1/>
    PREFIX prov: <http://www.w3.org/ns/prov#>
    PREFIX org: <http://www.w3.org/ns/org#>
    PREFIX schema: <http://schema.org/>

    :${id} a foaf:Project, prov:Activity;
        dcterms:title  <@displayLiteral title />  ;

        <#if description?has_content>
            dcterms:description <@displayLiteral description /> ;
        </#if>

        <@listFunding />
        <@listOutputs />
        <@listAssocations /> 
        frapo:hasHostInstitution <https://ror.org/00pggkr55> ;
        .

        <@assocationDetails />
        <@outputDetails />
        <@contributorDetails />
        <@listOrganisations />
        <@listFunds />
        <@listFunders />

        <#-- UKCEH object -->
        <https://ror.org/00pggkr55> a org:Organization ;
            foaf:name  "UK Centre for Ecology & Hydrology" ;
            schema:url <https://www.ceh.ac.uk> ;
            schema:email <mailto:enquiries@ceh.ac.uk>  .
</#compress>

<#macro displayLiteral string>
  <#--Ensure literals do not contain " characters-->
  "${string?trim?replace("\"","'")?replace("\n"," ")}"<#t>
</#macro>

<#macro displayUrl string>
  <${string}><#t>
</#macro>

<#-- Funding -->

    <#macro getAwardID award index=0>
        <#compress>
            <#local awardID = ":award_" + award.awardNumber?trim?replace("/","_") >
           
            <#if award.awardURI?matches("^http(|s)://doi.org/10\\..+$") >
                <#local awardID = "<" + award.awardURI + ">" >
            </#if>
            ${awardID}<#t>
       </#compress>
    </#macro>

    <#macro listFunding>
        <#if funding?? & funding?has_content>
            frapo:isFundedBy <#t>
            <#list funding as fund>
                <#if fund.awardNumber?? & fund.awardNumber?has_content>
                <@getAwardID fund fund?index /><#sep>,<#t> 
                </#if>
            </#list>
            ;
        </#if>
    </#macro>

    <#macro listFunds>
        <#if funding?? & funding?has_content>
            <#list funding as fund>
                <#if fund.awardNumber?? & fund.awardNumber?has_content>
                <@getAwardID fund fund?index /> a frapo:Grant;
                    frapo:hasGrantNumber <@displayLiteral fund.awardNumber /> ;
                    frapo:funds :${id} ;
                    <#if fund.awardURI?has_content>schema:url <@displayUrl fund.awardURI /></#if> .
                </#if>
            </#list>
        </#if>
    </#macro>

    <#macro listFunders>
        <#if funders??>
            <#list funders as funder>
                <#local funderID = ":funder_" + id + "_" + funder?index >

                ${funderID} a prov:Organization, org:Organization;
                <#if funder.organisationName?has_content>foaf:name <@displayLiteral funder.organisationName /> ;</#if>
                <#if funder.awards?? && funder.awards?has_content>
                    frapo:awards <#t>
                        <#list funder.awards as award>
                            <#t><@getAwardID award award?index /><#sep>,<#t>
                        </#list>;
                </#if>
                .
            </#list>
        </#if>
    </#macro>
<#-- Funding ENDS-->


<#-- Contributors -->
    <#macro getAssociationID contributor index=0>
      <#compress>
        <#local associationID = ":assoc_" + id + "_" + index >
        ${associationID}<#t>
       </#compress>
    </#macro>

    <#macro getContributorID contributor index=0>
      <#compress>
        <#local contributorID = ":contributor_" + id + "_" + index >

        <#if contributor.nameIdentifier?has_content >
            <#local contributorID = "<" + contributor.nameIdentifier + ">" >
        </#if>

        ${contributorID}<#t>
       </#compress>
    </#macro>

    <#macro listAssocations>
        <#if contributors?? & contributors?has_content>
            prov:qualifiedAssociation <#t>
            <#list contributors as contributor>
                <@getAssociationID contributor contributor?index /><#sep>,<#t>
            </#list>
            ;
        </#if>
    </#macro>

    <#macro assocationDetails>
        <#if contributors?? & contributors?has_content>
            <#list contributors as contributor>
               <@getAssociationID contributor contributor?index /> a prov:Association ;
                prov:agent <@getContributorID contributor contributor?index /> ;
                <#if contributor.contributorRole?has_content>prov:hadRole scoro:${contributor.contributorRole} ;</#if>
               .
            </#list>
        </#if>
    </#macro>

    <#macro contributorDetails>
        <#if contributors?? & contributors?has_content>
            <#list contributors as contributor>
                <#local provType = "prov:Organization" />
                    <#if contributor.fullName?? && contributor.fullName?has_content>
                        <#local provType = "prov:Person" />
                    </#if>

                <@getContributorID contributor contributor?index /> a ${provType} ;  
                    <#if contributor.fullName != '' >
                        foaf:name <@displayLiteral contributor.fullName />;
                    </#if>
                    <#if contributor.organisationIdentifier != '' >
                       org:memberOf <@displayUrl contributor.organisationIdentifier /> ;
                    <#else>
                        <#if contributor.organisationName != '' && contributor.organisationName != 'Unaffiliated'>
                        org:memberOf [
                            a org:Organization ;
                            skos:prefLabel <@displayLiteral contributor.organisationName />
                            ] ;
                        </#if>
                    </#if>
            .
            </#list>
        </#if>
    </#macro>
<#-- Contributors ENDS -->

<#-- Outputs -->
    <#macro listOutputs>
        <#if relHasOutput?? & relHasOutput?has_content>
            frapo:hasOutput <#t>
            <#list relHasOutput as output>
                 <${output.href}><#sep>,</#sep><#t>
            </#list> ;
        </#if>
    </#macro>

    <#macro outputDetails>
        <#if relHasOutput?? & relHasOutput?has_content>
            <#list relHasOutput as output>
                <${output.href}> a <#if output.associationType == 'dataset'>dcat:Dataset<#else>frapo:Deliverable</#if> ;
                    dcterms:title <@displayLiteral output.title /> ;
                .
            </#list>
        </#if>
    </#macro>
<#-- Outputs ENDS -->

<#-- Organisations -->
    <#macro listOrganisations>
        <#-- NB: Exclude UKCEH because that's already hard-coded -->
        <#if organisations?? & organisations?has_content>
            <#list organisations?filter(o -> o.organisationIdentifier!='https://ror.org/00pggkr55') as o>
                <@displayUrl o.organisationIdentifier /> a prov:Organization, org:Organization;
                <#if o.organisationName?has_content>foaf:name <@displayLiteral o.organisationName /> ;</#if>
                .
            </#list>
        </#if>
    </#macro>
<#-- Organisations ENDS -->


