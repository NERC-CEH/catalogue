<#compress>
    PREFIX : <${uri?replace(id,"")}>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX dcat: <http://www.w3.org/ns/dcat#>
    PREFIX frapo: <http://purl.org/cerif/frapo/>
    PREFIX scoro: <http://purl.org/spar/scoro/>
    PREFIX pro: <http://purl.org/spar/pro/>
    PREFIX foaf: <http://xmlns.com/foaf/0.1/>
    PREFIX schema: <http://schema.org/>

    :${id} a frapo:Project, schema:ResearchProject;
        dcterms:title  <@displayLiteral title />  ;

        <#if description?has_content>
            dcterms:description <@displayLiteral description /> ;
        </#if>

        <@outputList /> ;
        <@fundingList /> ;

        frapo:hasHostInstitution <https://ror.org/00pggkr55> ;
        .

        <@participants />

        <#-- UKCEH object -->
        <https://ror.org/00pggkr55> a schema:Organization ;
            rdfs:label "UK Centre for Ecology & Hydrology" ;
            schema:url <https://www.ceh.ac.uk> ;
            schema:email <mailto:enquiries@ceh.ac.uk>  .

        <@contributorDetails />
        <@outputDetails />
        <@fundingDetails />
        <@funderDetails />
</#compress>

<#macro displayLiteral string>
  <#--Ensure literals do not contain " characters-->
  "${string?trim?replace("\"","'")?replace("\n"," ")}"<#t>
</#macro>

<#-- Funding -->
    <#macro getFundID fund index=0>
        <#local fundID = ":fund_" + id + "_" + index >

        <#if fund.awardURI?matches("^http(|s)://doi.org/10\\..+$") >
            <#local fundID = "<" + fund.awardURI + ">" >
        <#elseif fund.awardNumber != '' >
            <#local fundID =  ":fund_" + fund.awardNumber?replace('/', '_') >
        </#if>

        ${fundID}<#t>
    </#macro>

    <#macro fundingDetails>
        <#if funding?? & funding?has_content>
            <#list funding as fund>

                <@getFundID fund fund?index /> a frapo:Grant;
                    <#if fund.awardNumber != '' >
                        frapo:hasGrantNumber <@displayLiteral fund.awardNumber />  ;
                    </#if>

                    <#if fund.funderIdentifier != '' >
                        frapo:hasFundingAgency <${fund.funderIdentifier}>;
                    </#if>

                    <#if fund.awardURI != '' >
                        schema:url <${fund.awardURI}>;
                    </#if>

                    <#if fund.awardTitle != '' >
                        dcterms:title <@displayLiteral fund.awardTitle />;
                    </#if>
            .
            </#list>
        </#if>
    </#macro>

    <#macro fundingList>
        <#if funding?? & funding?has_content>
        frapo:isSupportedBy <#t>
            <#list funding as fund>
                <@getFundID fund fund?index /><#sep>,</#sep><#t>
            </#list>
        </#if>
    </#macro>

    <#macro funderDetails>
        <#list funders as funder>
            <#if funder.funderIdentifier?has_content>
                <${funder.funderIdentifier}> a schema:Organization;
                schema:name <@displayLiteral funder.funderName /> .
            </#if>
        </#list>
    </#macro>
<#-- Funding  ENDS-->

<#-- Contributors -->
    <#macro getContributorID contributor index=0>
      <#compress>
        <#local contributorID = ":contributor_" + id + "_" + index >

        <#if contributor.nameIdentifier?has_content >
            <#local contributorID = "<" + contributor.nameIdentifier + ">" >
        </#if>

        ${contributorID}<#t>
       </#compress>
    </#macro>

    <#macro contributorDetails>
        <#if contributors?? & contributors?has_content>
            <#list contributors as contributor>

               <@getContributorID contributor contributor?index /> a foaf:Person ;  <#--What should this object be ? -->
                    <#if contributor.fullName != '' >
                        foaf:name <@displayLiteral contributor.fullName />;
                    </#if>
                    <#if contributor.organisationName != '' >
                        vcard:org <@displayLiteral contributor.organisationName />;<#--What should this predicate be ? -->
                    </#if>
            .
            </#list>
        </#if>
    </#macro>

    <#macro participants>
        <#if contributors?? & contributors?has_content>
            <#list contributors as contributor>
                :contriburion_${contributor?index} a pro:RoleInTime ;
                    pro:withRole scoro:project-member;
                    pro:relatesToPerson <@getContributorID contributor contributor?index />;
                    pro:relatesToDocument :${id} .
            </#list>
        </#if>
    </#macro>
<#-- Contributors ENDS -->


<#-- Outputs -->
    <#macro outputList>
        frapo:hasOutput <#t>
        <#if relHasOutput?? & relHasOutput?has_content>
            <#list relHasOutput as output>
                 <${output.href}><#sep>,</#sep><#t>
            </#list>
        </#if>
    </#macro>

    <#macro outputDetails>
        <#if relHasOutput?? & relHasOutput?has_content>
            <#list relHasOutput as output>
                <${output.href}> a <#if output.associationType == 'dataset'>dcat:Dataset<#else>frapo:Deliverable</#if> ;
                    dcterms:title <@displayLiteral output.title /> ;
                .
            </#list>
        </#if>
    </#macro>
<#-- Outputs ENDS -->

