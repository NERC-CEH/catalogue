{
    "name": "web",
    "description": "UKCEH Metadata Catalogue",
    "keywords": [],
    "author": "UKCEH Environmental Data Science Group",
    "license": "GPL-2.0-or-later",
    "private": "true",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "webpack --config webpack.js --mode production",
        "build-dev": "webpack --config webpack.js --mode development",
        "lint": "eslint .",
        "lint-fix": "eslint --fix .",
        "pretest": "node scripts/check-template-escaping.js && node scripts/build-test-css.js",
        "test": "vitest run",
        "pretest-coverage": "npm run pretest",
        "test-coverage": "vitest run --coverage",
        "watch": "webpack --config webpack.js --mode development --watch"
    },
    "browserslist": [
        "defaults"
    ],
    "babel": {
        "presets": [
            "@babel/preset-env"
        ],
        "plugins": [
            "./scripts/babel-plugin-precompile-templates"
        ]
    },
    "devDependencies": {
        "@babel/core": "^8.0.7",
        "@babel/preset-env": "^8.0.7",
        "@vitest/browser-playwright": "4.1.11",
        "@vitest/coverage-istanbul": "4.1.11",
        "babel-loader": "^10.1.1",
        "css-loader": "^7.1.5",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "mini-css-extract-plugin": "^2.10.2",
        "neostandard": "^0.14.1",
        "nise": "6.1.5",
        "playwright": "1.63.0",
        "postcss": "^8.5.30",
        "puppeteer": "^25.13.0",
        "sass": "^1.105.1",
        "sass-loader": "^17.0.1",
        "vite": "8.3.1",
        "vitest": "4.1.11",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@triply/yasgui": "4.2.28",
        "backbone": "^1.6.1",
        "bootstrap": "^5.3.8",
        "datatables.net-bs5": "^3.1.4",
        "deparam.js": "^3.0.16",
        "dropzone": "^6.3.5",
        "filesize": "^11.0.26",
        "jquery": "^4.0.0",
        "jquery-ui": "^1.14.2",
        "leaflet": "^1.9.4",
        "leaflet-draw": "^1.0.4",
        "leaflet.markercluster": "^1.5.3",
        "select2": "^4.1.0",
        "select2-bootstrap-5-theme": "~1.3.0",
        "sweetalert2": "^11.26.25",
        "underscore": "^1.13.8"
    }
}
